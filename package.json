{
  "name": "native-projects",
  "private": true,
  "version": "1.0.0",
  "description": "Official site for the x360-native, ps2-native, xone-native and ps3-native research projects.",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "data": "node scripts/fetch-github.mjs",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:fresh": "npm run data && npm run build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.35.5",
    "typescript": "5.6",
    "vite": "^6.4.6"
  }
}
